=== 2. PUBSPEC.YAML (USE EXACTLY THIS - DO NOT CHANGE VERSIONS) ===
name: ai_video_studio_pro
description: "A personal-use Android video and audio editing app powered by Flutter and FFmpeg."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: '>=3.5.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # File management & storage
  file_picker: ^8.1.2
  media_store_plus: ^1.0.3
  path_provider: ^2.1.2
  shared_preferences: ^2.2.2
  permission_handler: ^11.3.0

  # Video processing & AI
  ffmpeg_kit_flutter_new: ^4.6.0
  video_player: ^2.8.6
  google_mlkit_selfie_segmentation: ^0.10.1
  google_generative_ai: ^0.4.6

  # Background processing
  flutter_background_service: ^5.0.9

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0

flutter:
  uses-material-design: true

CRITICAL NOTES:
- ffmpeg_kit_flutter_new (NOT ffmpeg_kit_flutter_new_full_gpl - that name does NOT exist on pub.dev)
- google_mlkit_selfie_segmentation MUST be ^0.10.1 (NOT ^0.11.0 or ^0.13.0 - those need Dart 3.8+)
- flutter_lints MUST be ^4.0.0 (NOT ^5.0.0 or ^6.0.0 - those need Dart 3.8+)
- ffmpeg_kit_flutter_new: ^4.6.0 includes libx264 AND libx265 codecs

